#!/usr/bin/env bash
# SessionStart hook for lightweight-engineering (le) plugin

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read using-le content
using_le_content=$(cat "${PLUGIN_ROOT}/skills/using-le/SKILL.md" 2>&1 || echo "Error reading using-le skill")

# Escape string for JSON embedding using bash parameter substitution.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_le_escaped=$(escape_for_json "$using_le_content")
session_context="<EXTREMELY_IMPORTANT>\nYou are using the Lightweight Engineering plugin (le) to assist with software development in this codebase.\n\n**Below is the full content of your 'le:using-le' skill - your introduction to using skills. For all other skills, use the 'Skill' tool:**\n\n${using_le_escaped}\n</EXTREMELY_IMPORTANT>"

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  # Cursor sets CURSOR_PLUGIN_ROOT
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  # Claude Code sets CLAUDE_PLUGIN_ROOT without COPILOT_CLI
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  # Copilot CLI or other standard platforms
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi

exit 0
